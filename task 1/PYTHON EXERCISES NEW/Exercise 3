score = int(input("Enter your exam score (85-100): "))

if score < 85 or score > 100:
    print("Invalid score. Must be between 85 and 100.")

elif score >= 92:
    print("Grade: A")

elif score >= 80:
    print("Grade: B")

elif score >= 70:
    print("Grade: C")

elif score >= 60:
    print("Grade: D")

else:
    print("Grade: F")