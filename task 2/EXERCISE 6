from abc import ABC, abstractmethod


class Payment(ABC):
    @abstractmethod
    def pay(self, amount):
        pass


class CashPayment(Payment):
    def pay(self, amount):
        print(f"Paid Rs. {amount} using cash.")


class CardPayment(Payment):
    def pay(self, amount):
        print(f"Paid Rs. {amount} using a card.")


cash = CashPayment()
card = CardPayment()

cash.pay(500)
card.pay(1200)