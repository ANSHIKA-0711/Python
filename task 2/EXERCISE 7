
from abc import ABC, abstractmethod



class BankAccount(ABC):

    def __init__(self, account_holder, account_number, balance):
        self.account_holder = account_holder
        self.account_number = account_number
        self.__balance = balance

    
    def get_balance(self):
        return self.__balance

    def deposit(self, amount):
        if amount > 0:
            self.__balance += amount
            print("Deposit Successful:", amount)
        else:
            print("Invalid deposit amount")

    def withdraw(self, amount):
        if amount > 0 and amount <= self.__balance:
            self.__balance -= amount
            print("Withdrawal Successful:", amount)
        else:
            print("Insufficient balance or invalid amount")


    @abstractmethod
    def account_details(self):
        pass



class SavingsAccount(BankAccount):

    def __init__(self, account_holder, account_number, balance, interest_rate):
        super().__init__(account_holder, account_number, balance)
        self.interest_rate = interest_rate


    def account_details(self):
        print("\n--- Savings Account Details ---")
        print("Account Holder:", self.account_holder)
        print("Account Number:", self.account_number)
        print("Balance:", self.get_balance())
        print("Interest Rate:", self.interest_rate, "%")


class CurrentAccount(BankAccount):

    def __init__(self, account_holder, account_number, balance, overdraft_limit):
        super().__init__(account_holder, account_number, balance)
        self.overdraft_limit = overdraft_limit

    
    def account_details(self):
        print("\n--- Current Account Details ---")
        print("Account Holder:", self.account_holder)
        print("Account Number:", self.account_number)
        print("Balance:", self.get_balance())
        print("Overdraft Limit:", self.overdraft_limit)




account1 = SavingsAccount("Anu", 1001, 10000, 5)
account2 = CurrentAccount("Ravi", 1002, 20000, 5000)



account1.account_details()
account2.account_details()



print("\n--- Deposit Operation ---")
account1.deposit(5000)


print("\n--- Withdrawal Operation ---")
account1.withdraw(2000)



print("\n--- Final Account Balance ---")
print("Anu's Balance:", account1.get_balance())



print("\n--- Polymorphism Demonstration ---")

accounts = [account1, account2]

for account in accounts:
    account.account_details()